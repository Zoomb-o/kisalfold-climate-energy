# Copernicus CDS (ERA5 + CMIP6)
# Get your key at: https://cds.climate.copernicus.eu/user/register
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2
CDS_API_KEY=your-uid:your-api-key

# ENTSO-E Transparency Platform
# Request key at: https://transparency.entsoe.eu (My Account > Security Token)
ENTSO_E_API_KEY=your-api-key-here

# Kisalföld bounding box (do not change)
BBOX_NORTH=47.8
BBOX_SOUTH=47.2
BBOX_WEST=17.0
BBOX_EAST=18.0

# ERA5 download settings
ERA5_START_YEAR=1970
ERA5_END_YEAR=2024
